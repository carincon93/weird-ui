{
  "name": "@carincon93/weird-ui",
  "version": "0.0.1",
  "description": "Reusable React UI components powered by GSAP animations and Tailwind CSS.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Cristian Rincón",
  "repository": {
    "type": "git",
    "url": "https://github.com/carincon93/weird-ui"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "gsap",
    "tailwind",
    "animations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/styles.css --minify",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19.2.5",
    "react-dom": ">=19.2.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/cli": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "rimraf": "^6.1.3",
    "shadcn": "^4.3.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}